#!/usr/bin/env bash
#
# pre-push hook — runs the Somnio CLI test suite and blocks the push unless
# line coverage of `cli/lib` is at or above the threshold (default 85%).
#
# Enable it once per clone with:
#   git config core.hooksPath .githooks
#
# Override the threshold for a single push:
#   COVERAGE_MIN=90 git push
#
# Bypass entirely (use sparingly):
#   git push --no-verify
#
set -euo pipefail

COVERAGE_MIN="${COVERAGE_MIN:-85}"

# Resolve the repo root from the hook's own location so it works from any CWD.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLI_DIR="$REPO_ROOT/cli"

if [ ! -f "$CLI_DIR/pubspec.yaml" ]; then
  echo "pre-push: cannot find cli/ at $CLI_DIR — skipping coverage gate." >&2
  exit 0
fi

cd "$CLI_DIR"

echo "pre-push: running CLI tests with coverage (min ${COVERAGE_MIN}%)…"

# 1. Ensure dependencies are present.
dart pub get >/dev/null

# 2. Run the suite, emitting raw coverage into ./coverage.
rm -rf coverage
dart test --coverage=coverage

# 3. Convert to lcov and enforce the per-file threshold (shared with CI).
COVERAGE_MIN="$COVERAGE_MIN" "$CLI_DIR/tool/coverage_gate.sh" || {
  echo "" >&2
  echo "   To bypass intentionally: 'git push --no-verify'." >&2
  exit 1
}

exit 0
